import numpy as np

MODEL='model.pkl'
DATA='data.pkl'

if not os.path.exists(MODEL):
   data_2_features=data_2.drop("median_house_value",axis=1)
   data_2_labels=data_2[['median_house_value']]

   numbers_columns=data_2_features.select_dtypes(include=np.number).columns
   cat_columns=['ocean_proximity']
   
   number_pipeline=Pipeline([
       ('Impute',SimpleImputer(strategy='mean'))
   ])
   
   features_pipeline=Pipeline([
       ('Encoder',OneHotEncoder(handle_unknown='ignore'))
       
