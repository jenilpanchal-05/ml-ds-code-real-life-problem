   data_2['number_string']=pd.cut(data_2['median_income'],bins=[-1,1.5,3,4.5,6,7.5,np.inf],labels=[1,2,3,4,5,6])
   for x , y in splitting.split(data_2,data_2['number_string']):
       # We do like this because we want to match the numbers 1,2,3,4,5,6 in both and string variable does not affect it at all
       test_size=data_2.iloc[x]
